rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /signals/{signalId} {
      allow read, write: if true;
    }
    match /academy/{moduleId} {
      allow read, write: if true;
    }
    match /exchanges/{exId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
    match /marketCoins/{coinId} {
      allow read, write: if true;
    }
    match /tradeJournal/{journalId} {
      allow read, write: if true;
    }
    match /settings/{docId} {
      allow read, write: if true;
    }
    match /chats/{chatId} {
      allow read, write: if true;
    }
    match /telegramConfig/{configId} {
      allow read, write: if true;
    }
  }
}
